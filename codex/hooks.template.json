{
  "description": "__DEVKIT_CODEX_HOOKS_DESCRIPTION__",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__DEVKIT_CODEX_SLASH_COMMAND__",
            "statusMessage": "Checking devkit command...",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ safety-check.sh", "timeout": 5 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ audit-trail.sh", "timeout": 5 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ pr-gate.sh", "timeout": 5 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ devkit-guard.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ safety-check.sh", "timeout": 5 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ security-patterns.sh", "timeout": 5 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ devkit-guard.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "mcp__devkit__advance",
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ devkit-guard.sh", "timeout": 5 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_PERMISSION_COMMAND__", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ post-validate.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ post-validate.sh", "timeout": 10 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ lang-review.sh", "timeout": 10 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ slop-detect.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ stop-gate.sh", "timeout": 10 },
          { "type": "command", "command": "__DEVKIT_CODEX_HOOK_COMMAND__ devkit-stop-guard.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
